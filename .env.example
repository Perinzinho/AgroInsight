# Porta local da aplicação (Docker Compose).
AGROINSIGHT_PORT=5174

# Opcional: configure para habilitar a análise por IA.
# Configure a chave de um ou mais provedores. A interface permite escolher.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODELS=google/gemini-2.5-flash,openai/gpt-4.1-mini
# Opcional: AI_PROVIDER=gemini, openrouter ou openai (padrão: primeiro configurado).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=gpt-4.1-mini
