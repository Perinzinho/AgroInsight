GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODELS=google/gemini-2.5-flash,openai/gpt-4.1-mini
# Opcional: AI_PROVIDER=gemini, openrouter ou openai (padrão: primeiro configurado).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=gpt-4.1-mini
AI_HOST=127.0.0.1
AI_PORT=5175
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_INPUT_TOKENS=12000
AI_MAX_TOOL_ROUNDS=4
AI_MAX_TOOL_CALLS=8
AI_MAX_PROVIDER_CALLS=6
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_CONCURRENT_REQUESTS=2
AI_DATA_DIR=./public/data
